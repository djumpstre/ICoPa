# Copy to .private/hub.env, then: set -a; . .private/hub.env; set +a
PYTHONPATH=/workspace:/workspace/icopa_hub:/workspace/icopa_cli
DJANGO_SETTINGS_MODULE=settings.settings
ICOPA_CONFIG=/workspace/.private/cli.config
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# Leave empty for an automatically generated, ignored development key.
# Set a unique random key of at least 50 characters before DJANGO_DEBUG=0.
DJANGO_SECRET_KEY=
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
# Optional: set these to your own configured catalogs; public image fields are empty.
# ICOPA_PRESET_CONTAINERS_PATH=/workspace/.private/configs/general_containers.yaml
# ICOPA_ZENOH_ROUTER_PRESETS_PATH=/workspace/.private/configs/zenoh_router_containers.yaml
